# ╔══════════════════════════════════════════════════════════════╗
# ║        Huawei WiFi BE3 Scraper — Configuration             ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Router Settings ───────────────────────────────────────────
# IP address of your Huawei WiFi BE3 router
ROUTER_HOST=192.168.1.1

# HTTP port (80 for HTTP, 443 for HTTPS)
ROUTER_PORT=80

# NOTE: The router has no username field — it uses 'admin' internally.
# You do NOT need to set a username.

# Router admin password (REQUIRED — set this!)
ROUTER_PASSWORD=your_password_here

# Use SSL/HTTPS? (true/false)
USE_SSL=false

# ── Zabbix Settings ──────────────────────────────────────────
# IP or hostname of your Zabbix Server
ZABBIX_SERVER=127.0.0.1

# Zabbix Trapper port (default: 10051)
ZABBIX_PORT=10051

# Host name in Zabbix (must match EXACTLY the technical host name
# configured in Zabbix → Configuration → Hosts)
ZABBIX_HOST=HuaweiBE3

# ── Scraper Settings ─────────────────────────────────────────
# How often to scrape the router (in seconds)
POLL_INTERVAL=30

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
